Recommended Approach
I recommend Solution 2 (Custom DOM Conversion) because it:

✅ Handles import automatically
✅ Handles export automatically
✅ Works with copy/paste
✅ Maintains attributes in the HTML
✅ Is the most maintainable long-term

Here's the complete implementation:
typescript// CustomTableNode.ts
import { TableNode, SerializedTableNode, $isTableNode } from '@lexical/table';
import { DOMConversionMap, DOMConversionOutput, EditorConfig, NodeKey } from 'lexical';

export class CustomTableNode extends TableNode {
  __bordersOn: boolean;
  __rowStriping: boolean;

  constructor(bordersOn = true, rowStriping = false, key?: NodeKey) {
    super(key);
    this.__bordersOn = bordersOn;
    this.__rowStriping = rowStriping;
  }

  static getType() {
    return 'table';
  }

  static clone(node: CustomTableNode) {
    return new CustomTableNode(node.__bordersOn, node.__rowStriping, node.__key);
  }

  static importDOM(): DOMConversionMap | null {
    return {
      table: () => ({
        conversion: (element: HTMLElement): DOMConversionOutput => {
          const bordersOn = element.getAttribute('data-borders-on') !== 'false';
          const rowStriping = element.getAttribute('data-row-striping') === 'true';
          
          return {
            node: new CustomTableNode(bordersOn, rowStriping),
          };
        },
        priority: 1,
      }),
    };
  }

  exportJSON() {
    return {
      ...super.exportJSON(),
      bordersOn: this.__bordersOn,
      rowStriping: this.__rowStriping,
      type: 'table',
      version: 1,
    };
  }

  static importJSON(serializedNode: any) {
    return new CustomTableNode(
      serializedNode.bordersOn ?? true,
      serializedNode.rowStriping ?? false
    );
  }

  createDOM(config: EditorConfig) {
    const element = super.createDOM(config);
    element.setAttribute('data-borders-on', String(this.__bordersOn));
    element.setAttribute('data-row-striping', String(this.__rowStriping));
    
    if (this.__bordersOn) element.classList.add('table-borders-on');
    if (this.__rowStriping) element.classList.add('table-row-striping');
    
    return element;
  }

  updateDOM(prevNode: CustomTableNode, dom: HTMLElement) {
    let needsUpdate = super.updateDOM(prevNode, dom);
    
    if (prevNode.__bordersOn !== this.__bordersOn) {
      dom.setAttribute('data-borders-on', String(this.__bordersOn));
      dom.classList.toggle('table-borders-on', this.__bordersOn);
      needsUpdate = true;
    }
    
    if (prevNode.__rowStriping !== this.__rowStriping) {
      dom.setAttribute('data-row-striping', String(this.__rowStriping));
      dom.classList.toggle('table-row-striping', this.__rowStriping);
      needsUpdate = true;
    }
    
    return needsUpdate;
  }

  getBordersOn() { return this.__bordersOn; }
  setBordersOn(value: boolean) { this.getWritable().__bordersOn = value; }
  getRowStriping() { return this.__rowStriping; }
  setRowStriping(value: boolean) { this.getWritable().__rowStriping = value; }
}
