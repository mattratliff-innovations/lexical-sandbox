Here's a full working example:
javascript// Editor.jsx
import React, { useState, useEffect } from 'react';
import { LexicalComposer } from '@lexical/react/LexicalComposer';
import { RichTextPlugin } from '@lexical/react/LexicalRichTextPlugin';
import { ContentEditable } from '@lexical/react/LexicalContentEditable';
import { HistoryPlugin } from '@lexical/react/LexicalHistoryPlugin';
import { TablePlugin } from '@lexical/react/LexicalTablePlugin';
import LexicalErrorBoundary from '@lexical/react/LexicalErrorBoundary';
import { TableCellNode, TableRowNode } from '@lexical/table';
import { CustomTableNode } from './nodes/CustomTableNode';
import { LoadContentComponent } from './components/LoadContentComponent';
import { TableControls } from './components/TableControls';
import { SaveButton } from './components/SaveButton';

const editorConfig = {
  namespace: 'MyEditor',
  theme: {
    // your theme
  },
  nodes: [
    CustomTableNode,
    TableCellNode,
    TableRowNode,
  ],
  onError: (error) => {
    console.error(error);
  },
};

export default function Editor({ documentId }) {
  const [htmlContent, setHtmlContent] = useState('');

  useEffect(() => {
    // Load from database
    fetch(`/api/documents/${documentId}`)
      .then(res => res.json())
      .then(data => setHtmlContent(data.html_content));
  }, [documentId]);

  return (
    <LexicalComposer initialConfig={editorConfig}>
      <div className="editor-container">
        <div className="toolbar">
          <TableControls />
          <SaveButton documentId={documentId} />
        </div>
        
        <RichTextPlugin
          contentEditable={<ContentEditable className="editor-input" />}
          placeholder={<div className="editor-placeholder">Start typing...</div>}
          ErrorBoundary={LexicalErrorBoundary}
        />
        
        <HistoryPlugin />
        <TablePlugin />
        <LoadContentComponent htmlContent={htmlContent} />
      </div>
    </LexicalComposer>
  );
}
Key Points

Automatic Import: When you use $generateNodesFromDOM, it automatically calls CustomTableNode.importDOM() for any <table> elements
Automatic Export: When you use $generateHtmlFromNodes, it automatically calls CustomTableNode.createDOM() which adds the data attributes
Type Safety: The instanceof CustomTableNode checks ensure you're working with the right node type
Persistence: The data attributes (data-borders-on, data-row-striping) are stored in your HTML in the database

