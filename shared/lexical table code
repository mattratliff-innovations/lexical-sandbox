Step 2: Import HTML from Database
When loading content from your database:
javascriptimport { useLexicalComposerContext } from '@lexical/react/LexicalComposerContext';
import { $generateNodesFromDOM } from '@lexical/html';
import { $getRoot } from 'lexical';
import { useEffect } from 'react';

function LoadContentComponent({ htmlContent }) {
  const [editor] = useLexicalComposerContext();

  useEffect(() => {
    if (!htmlContent) return;

    editor.update(() => {
      // Parse HTML
      const parser = new DOMParser();
      const dom = parser.parseFromString(htmlContent, 'text/html');

      // Generate Lexical nodes from DOM
      // CustomTableNode.importDOM() will automatically be called for <table> elements
      const nodes = $generateNodesFromDOM(editor, dom);

      // Clear existing content and insert new nodes
      const root = $getRoot();
      root.clear();
      root.append(...nodes);
    });
  }, [editor, htmlContent]);

  return null;
}

// Usage in your editor
function MyEditor() {
  const [content, setContent] = useState('');

  useEffect(() => {
    // Fetch from your Ruby backend
    fetch('/api/documents/123')
      .then(res => res.json())
      .then(data => setContent(data.html_content));
  }, []);

  return (
    <LexicalComposer initialConfig={editorConfig}>
      <LoadContentComponent htmlContent={content} />
      {/* Other editor components */}
    </LexicalComposer>
  );
}
// Step 3: Create Tables Programmatically
// When creating new tables in the editor:
// javascrip

import { useLexicalComposerContext } from '@lexical/react/LexicalComposerContext';
import { INSERT_TABLE_COMMAND } from '@lexical/table';
import { $getSelection, $isRangeSelection } from 'lexical';
import { $findMatchingParent } from '@lexical/utils';
import { CustomTableNode } from './nodes/CustomTableNode';

function TableInsertButton() {
  const [editor] = useLexicalComposerContext();

  const insertTable = () => {
    editor.dispatchCommand(INSERT_TABLE_COMMAND, {
      columns: '3',
      rows: '3',
      includeHeaders: false,
    });

    // The table will be created as CustomTableNode automatically
    // because it's registered in the editor config
    
    // Optionally, you can customize it right after insertion
    editor.update(() => {
      const selection = $getSelection();
      if ($isRangeSelection(selection)) {
        const anchorNode = selection.anchor.getNode();
        const tableNode = $findMatchingParent(anchorNode, (node) => 
          node instanceof CustomTableNode
        );
        
        if (tableNode instanceof CustomTableNode) {
          // Set custom properties
          tableNode.setBordersOn(true);
          tableNode.setRowStriping(false);
        }
      }
    });
  };

  return <button onClick={insertTable}>Insert Table</button>;
}

// Step 4: Toggle Table Attributes
// Create controls to toggle borders and row striping:
// javascript

import { useLexicalComposerContext } from '@lexical/react/LexicalComposerContext';
import { $getSelection, $isRangeSelection } from 'lexical';
import { $findMatchingParent } from '@lexical/utils';
import { CustomTableNode } from './nodes/CustomTableNode';
import { useState, useEffect } from 'react';

function TableControls() {
  const [editor] = useLexicalComposerContext();
  const [bordersOn, setBordersOn] = useState(true);
  const [rowStriping, setRowStriping] = useState(false);
  const [hasTable, setHasTable] = useState(false);

  // Update state when selection changes
  useEffect(() => {
    return editor.registerUpdateListener(({ editorState }) => {
      editorState.read(() => {
        const selection = $getSelection();
        if ($isRangeSelection(selection)) {
          const anchorNode = selection.anchor.getNode();
          const tableNode = $findMatchingParent(anchorNode, (node) => 
            node instanceof CustomTableNode
          );
          
          if (tableNode instanceof CustomTableNode) {
            setHasTable(true);
            setBordersOn(tableNode.getBordersOn());
            setRowStriping(tableNode.getRowStriping());
          } else {
            setHasTable(false);
          }
        }
      });
    });
  }, [editor]);

  const toggleBorders = () => {
    editor.update(() => {
      const selection = $getSelection();
      if ($isRangeSelection(selection)) {
        const anchorNode = selection.anchor.getNode();
        const tableNode = $findMatchingParent(anchorNode, (node) => 
          node instanceof CustomTableNode
        );
        
        if (tableNode instanceof CustomTableNode) {
          tableNode.setBordersOn(!bordersOn);
        }
      }
    });
  };

  const toggleRowStriping = () => {
    editor.update(() => {
      const selection = $getSelection();
      if ($isRangeSelection(selection)) {
        const anchorNode = selection.anchor.getNode();
        const tableNode = $findMatchingParent(anchorNode, (node) => 
          node instanceof CustomTableNode
        );
        
        if (tableNode instanceof CustomTableNode) {
          tableNode.setRowStriping(!rowStriping);
        }
      }
    });
  };

  if (!hasTable) return null;

  return (
    <div className="table-controls">
      <button 
        onClick={toggleBorders}
        className={bordersOn ? 'active' : ''}
      >
        {bordersOn ? 'Hide' : 'Show'} Borders
      </button>
      <button 
        onClick={toggleRowStriping}
        className={rowStriping ? 'active' : ''}
      >
        {rowStriping ? 'Disable' : 'Enable'} Row Striping
      </button>
    </div>
  );
}
