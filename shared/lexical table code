When saving back to the database:
javascriptimport { $generateHtmlFromNodes } from '@lexical/html';

function SaveButton() {
  const [editor] = useLexicalComposerContext();

  const saveContent = async () => {
    let htmlString = '';

    editor.getEditorState().read(() => {
      // CustomTableNode.createDOM() will automatically add data attributes
      htmlString = $generateHtmlFromNodes(editor);
    });

    // Save to your Ruby backend
    await fetch('/api/documents/123', {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${yourToken}`,
      },
      body: JSON.stringify({
        html_content: htmlString,
      }),
    });
  };

  return <button onClick={saveContent}>Save</button>;
}
