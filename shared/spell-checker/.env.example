# Environment Configuration for Spell-Check Microservice
# Copy this file to .env and update with your values

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-signing-key-here
JWT_ISSUER=your-application-name
JWT_AUDIENCE=your-application-users

# LanguageTool Configuration  
JAVA_OPTS=-Xmx2g

# General Configuration
NODE_ENV=production

# Optional: Custom LanguageTool version
LANGUAGETOOL_VERSION=6.4